{
  "name": "farvist",
  "version": "0.9.0",
  "description": "A lightweight (~20 KB) glassmorphism CSS framework — frosted surfaces, neon glow, gradients, 30+ components and dark/light themes. A drop-in alternative to Bootstrap and Tailwind.",
  "license": "MIT",
  "author": "FloKuersten",
  "homepage": "https://farvist.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FloKuersten/farvist.git"
  },
  "bugs": {
    "url": "https://github.com/FloKuersten/farvist/issues"
  },
  "keywords": [
    "css",
    "sass",
    "scss",
    "framework",
    "glassmorphism",
    "glass",
    "ui-kit",
    "design-tokens",
    "dark-mode",
    "utility-classes",
    "bootstrap-alternative",
    "tailwind-alternative"
  ],
  "main": "dist/farvist.css",
  "style": "dist/farvist.css",
  "sass": "scss/farvist.scss",
  "sideEffects": [
    "dist/*.css",
    "assets/farvist.js"
  ],
  "files": [
    "scss",
    "dist",
    "assets",
    "llms.txt",
    "llms-full.txt",
    "ai-context.json"
  ],
  "scripts": {
    "build": "sass scss/farvist.scss dist/farvist.css --style=expanded --no-source-map",
    "build:min": "sass scss/farvist.scss dist/farvist.min.css --style=compressed --no-source-map",
    "build:all": "npm run build && npm run build:min && npm run build:ai",
    "build:ai": "node scripts/gen-ai-context.mjs",
    "watch": "sass --watch scss/farvist.scss dist/farvist.css --style=expanded",
    "dev": "npm run build:all",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "prepublishOnly": "npm run build:all"
  },
  "devDependencies": {
    "sass": "^1.83.0"
  }
}
